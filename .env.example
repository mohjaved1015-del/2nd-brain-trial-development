# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — the only generation key needed right now. Get a free key at
# aistudio.google.com. TEMPORARY per decisions/log.md: the production
# target is Claude Sonnet (ANTHROPIC_API_KEY below), swapped in once
# there's budget.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (generation) — the real production target once there's budget.
# Not used while GEMINI_API_KEY is set; see src/lib/generation/answer.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Unstructured.io (document parsing) — not needed until real document
# ingestion starts.
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# No embeddings vendor needed: retrieval is keyword-only for now (pure
# Postgres full-text search, see supabase/migrations/0003_keyword_search.sql
# and decisions/log.md). OPENAI_API_KEY / Voyage would come back only if
# vector search is reintroduced later.
