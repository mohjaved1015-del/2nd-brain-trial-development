# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — TEMPORARY free-tier substitute for both generation and embeddings
# while testing (see decisions/log.md). Get a free key at aistudio.google.com.
# Covers what ANTHROPIC_API_KEY + OPENAI_API_KEY would otherwise do below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Anthropic (generation) — the real production target once there's budget.
# Not used while GEMINI_API_KEY is set; see src/lib/generation/answer.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Embeddings — OpenAI text-embedding-3-small (1536 dims, matches the chunks.embedding
# column). The real production target once there's budget; not used while
# GEMINI_API_KEY is set. See src/lib/ingestion/embed.ts.
OPENAI_API_KEY=

# Unstructured.io (document parsing)
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
